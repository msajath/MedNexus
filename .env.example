# Docker Compose settings. Copy to .env; never commit secrets.
# Generate separate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONGO_USERNAME=mednexus
# Use generated hex so the password is URI-safe.
MONGO_PASSWORD=
# Separate, restricted application account. Use another generated hex secret.
MONGO_APP_USERNAME=mednexus_app
MONGO_APP_PASSWORD=
JWT_SECRET=
JWT_EXPIRE=7d
CLINIC_TIME_ZONE=Asia/Colombo
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
ALLOWED_ORIGINS=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional release images; use the same commit for both:
# BACKEND_IMAGE=ghcr.io/owner/repository-backend:sha-<full-commit-sha>
# FRONTEND_IMAGE=ghcr.io/owner/repository-frontend:sha-<full-commit-sha>
