# Copy to .env.atlas and replace placeholders. Never commit .env.atlas.
# Atlas database user must have access to medibook; encode reserved password characters.
ATLAS_MONGO_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@CLUSTER.mongodb.net/medibook?appName=Cluster0
JWT_SECRET=
JWT_EXPIRE=7d
CLINIC_TIME_ZONE=Asia/Colombo
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
ALLOWED_ORIGINS=https://your-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional release images; use the same tested commit for both.
# BACKEND_IMAGE=ghcr.io/owner/repository-backend:sha-<full-commit-sha>
# FRONTEND_IMAGE=ghcr.io/owner/repository-frontend:sha-<full-commit-sha>
