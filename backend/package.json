{
  "name": "medibook-backend",
  "version": "1.0.0",
  "description": "MediBook Healthcare Platform - Express/MongoDB Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seeder.js",
    "bootstrap-admin": "node scripts/bootstrapAdmin.js",
    "reset-password": "node scripts/resetDevPassword.js",
    "audit:db": "node scripts/auditDatabaseSecurity.js",
