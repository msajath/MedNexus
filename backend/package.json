    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "js-yaml": "^4.1.1"
