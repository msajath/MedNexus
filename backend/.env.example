# Example environment variables for backend
# Copy this file to `.env` and fill the values for your environment.

# App
PORT=5000
NODE_ENV=development
CLINIC_TIME_ZONE=Asia/Colombo
ALLOWED_ORIGINS=http://localhost:5173
# The app trusts its nearest reverse proxy on Render. Local direct requests
# trust no proxy. Set 1 explicitly behind the configured Nginx/Render proxy,
# or 0 to disable proxy trust. Do not use true or increase the hop count blindly.
# TRUST_PROXY=1
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRE=7d
SEED_PASSWORD=only_for_local_database_seeding

# MongoDB
MONGO_URI=mongodb://localhost:27017/medibook
# Atlas alternative: mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@CLUSTER.mongodb.net/medibook?appName=Cluster0
# Add the backend/server IP in Atlas Network Access and grant DB_USER access to medibook.
# Optional standard fallback must select the same database. Remote standard URIs
# require tls=true in production; never disable certificate verification.
# MONGO_STANDARD_URI=mongodb://DB_USER:URL_ENCODED_PASSWORD@HOST:27017/medibook?tls=true&authSource=admin
# DEV_COMPOSE_MONGO is set only by the isolated development Compose file. Do not
# enable it for native development, Atlas, Render, or staging. It never exempts
# a production connection from TLS and accepts only the exact private dev target.

# SMTP (for real email delivery) - optional for local development
# Without SMTP credentials, development only logs a delivery warning. Production
# email delivery fails safely; reset codes and email bodies are never logged.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="MediBook <no-reply@example.com>"

# Notes:
# - For Gmail SMTP use: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (or 465 for SSL), set SMTP_USER and SMTP_PASS.
# - For production use a transactional email provider (SendGrid, Mailgun, Amazon SES).
# - Storing secrets in environment variables is recommended; don't commit real secrets to git.
